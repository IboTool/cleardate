{
  "name": "cleardate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side drug clearance visualiser for ibogaine-clinic intake. Reference use only.",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate && npm run structures:render",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "tsx tools/e2e-library.ts",
    "init-data": "tsx tools/init-data.ts",
    "validate": "tsx tools/validate-drugs.ts",
    "migrate-v2": "tsx tools/migrate-v2.ts",
    "migrate-v2.1": "tsx tools/migrate-v2.1.ts",
    "migrate-v2.2": "tsx tools/migrate-v2.2.ts",
    "migrate-v2.3": "tsx tools/migrate-v2.3.ts",
    "migrate-v2.4": "tsx tools/migrate-v2.4.ts",
    "apply-worksheet-2026-10": "tsx tools/apply-worksheet-2026-10.ts",
    "editor": "vite --config tools/editor/vite.config.ts",
    "screenshots": "tsx tools/screenshots.ts",
    "structures:lookup": "tsx tools/structures/lookup.ts",
    "structures:render": "tsx tools/structures/render.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "echarts": "^6.1.0",
    "fuse.js": "^7.5.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@rdkit/rdkit": "^2026.9.1",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
